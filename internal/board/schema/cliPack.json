										"type": "boolean"
									}
								}
							}
						]
					}
				}
			}
		}
	],
	"$defs": {
		"newNode": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "text"],
					"properties": {
						"type": {
							"const": "card"
						},
						"parentId": {
							"type": "string",
							"pattern": "^([fn][1-9][0-9]*|\\$[A-Za-z0-9_-]{1,64})$"
						},
						"text": {
							"type": "string"
						},
						"color": {
							"enum": ["gray", "yellow", "green", "blue", "purple", "red"]
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "asset"],
					"properties": {
						"type": {
							"const": "image"
						},
						"parentId": {
							"type": "string",
							"pattern": "^([fn][1-9][0-9]*|\\$[A-Za-z0-9_-]{1,64})$"
						},
						"asset": {
							"type": "string",
							"pattern": "^assets/[0-9a-f]{64}\\.(png|jpg|gif|webp)$"
						},
						"caption": {
							"type": "string"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "title", "order"],
					"properties": {
						"type": {
							"const": "frame"
						},
						"parentId": {
							"type": "string",
							"pattern": "^([fn][1-9][0-9]*|\\$[A-Za-z0-9_-]{1,64})$"
						},
						"title": {
							"type": "string"
						},
						"order": {
							"type": "number"
						}
					}
				}
			]
		}
	}
}
