						},
						"z": {
							"type": "number"
						}
					},
					"dependentRequired": {
						"x": ["y"],
						"y": ["x"]
					}
				}
			]
		},
		"edge": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "rev", "from", "to"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^e[1-9][0-9]*$"
				},
				"rev": {
					"type": "integer",
					"minimum": 0
				},
				"from": {
					"type": "string",
					"pattern": "^[fn][1-9][0-9]*$"
				},
				"to": {
					"type": "string",
					"pattern": "^[fn][1-9][0-9]*$"
				},
				"label": {
					"type": "string"
				}
			}
		},
		"thread": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "rev", "target", "resolved", "orphaned", "messages"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^t[1-9][0-9]*$"
				},
				"rev": {
					"type": "integer",
					"minimum": 0
				},
				"target": {
					"$ref": "#/$defs/target"
				},
				"resolved": {
					"type": "boolean"
				},
				"orphaned": {
					"type": "boolean"
				},
				"targetLabel": {
					"type": "string"
				},
				"messages": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/message"
					}
				}
			}
		},
		"message": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "author", "body", "createdAt"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^m[1-9][0-9]*$"
				},
				"author": {
					"$ref": "#/$defs/author"
				},
				"body": {
					"type": "string",
					"minLength": 1,
					"maxLength": 65536
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"author": {
			"type": "object",
			"additionalProperties": false,
			"required": ["role"],
			"properties": {
				"role": {
					"type": "string",
					"minLength": 1
				},
				"roomId": {
					"type": "string"
				}
			}
		},
		"target": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind"],
					"properties": {
						"kind": {
							"const": "board"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "id"],
					"properties": {
						"kind": {
							"enum": ["frame", "node", "edge"]
						},
						"id": {
							"type": "string",
							"pattern": "^[fne][1-9][0-9]*$"
						}
					}
				}
			]
		}
	}
}
