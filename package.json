{
	"name": "peer",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build:web": "vite build --config web/vite.config.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck:plugin",
		"typecheck:plugin": "node scripts/typecheck-plugin.ts",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"knip": "knip",
		"test:plugin": "claude plugin test plugin",
		"engine-check": "node scripts/engine-check.ts",
		"test:web": "node --test 'web/src/**/*.test.ts'",
		"verify": "npm run typecheck && npm run check && npm run knip && npm run test:web && npm run build:web",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@dagrejs/dagre": "3.1.1",
		"@fontsource/inter": "5.3.0",
		"@xyflow/react": "12.12.0",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "26.6.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"knip": "6.39.0",
		"lefthook": "2.1.16",
		"typescript": "7.0.2",
		"vite": "8.3.2"
	},
	"allowScripts": {
		"esbuild": true,
		"lefthook": true
	}
}
