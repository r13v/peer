{
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023", "dom", "dom.iterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"types": ["node", "vite/client"]
	},
	"include": ["web/src", "web/vite.config.ts", "knip.config.ts"]
}
